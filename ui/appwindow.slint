import {
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    TextEdit,
    ListView,
} from "std-widgets.slint";

import {
    Theme,
    StripeBlockUI,
    GraphPoint,
    Card,
    CustomButton,
    LegendBadge,
} from "theme.slint";
import { BlockMap } from "block_map.slint";
import { PerformanceGraph } from "performance_graph.slint";
import { TelemetryPanel } from "telemetry_panel.slint";

export { StripeBlockUI, GraphPoint }
export component AppWindow inherits Window {
    title: "SymStripe Studio - RAM & Parallel Storage Accelerator";
    min-width: 1140px;
    min-height: 860px;
    preferred-width: 1200px;
    preferred-height: 900px;
    background: Theme.app-bg;

    // Profile state
    in-out property <[string]> profile_names: ["Default Profile"];
    in-out property <int> active_profile_idx: 0;

    // Top Architecture Paradigm: 0 = In-Place Optimizer, 1 = Virtual Storage Pool
    in-out property <int> active_mode_idx: 0;

    // Paradigm 1: In-Place Game Optimizer Properties
    in-out property <string> primary_path: "";
    in-out property <[StandardListViewItem]> target_drives_list: [];
    in-out property <string> min_size_mb_text: "64";
    in-out property <string> exclusions_text: "exe, dll, pdb, utoc, sig";
    in-out property <string> media_extensions_text: "bik, bk2, mp4, fsb, pck, wem";
    in-out property <bool> keep_backup: true;
    in-out property <bool> aggressive_media: false;
    in-out property <bool> ue5_safe_mode: true;
    in-out property <bool> is_already_striped: false;

    // Paradigm 2: Virtual Storage Pool Properties
    in-out property <[StandardListViewItem]> pool_members_list: [];
    in-out property <int> pool_policy_idx: 1; // 0 = Capacity (JBOD), 1 = Speed (RAID-0)
    in-out property <int> pool_stripe_mb: 64;
    in-out property <string> pool_mount_point: "Z:";
    in-out property <string> pool_custom_size_gb_text: "0";
    in-out property <string> pool_ram_cache_mb_text: "2048";
    in-out property <bool> is_pool_mounted: false;

    // Enterprise VFS Features
    in-out property <int> vfs_codec_index: 0; // 0=LZ4, 1=Zstd ATG, 2=Store
    in-out property <bool> tiered_storage_enabled: false;
    in-out property <bool> auto_start_enabled: false;
    in-out property <string> cache_hit_rate_text: "0.0%";
    in-out property <string> saved_space_text: "0.00 GB";

    // Real-Time I/O Telemetry properties
    in-out property <string> drive1_label: "Drive 1 (Primary)";
    in-out property <string> drive2_label: "Drive 2 (Secondary)";
    in-out property <string> drive1_speed_text: "0.0 MB/s";
    in-out property <string> drive2_speed_text: "0.0 MB/s";
    in-out property <float> drive1_load_pct: 0.0;
    in-out property <float> drive2_load_pct: 0.0;
    in-out property <string> total_io_text: "0.0 MB/s";
    in-out property <bool> is_io_active: false;

    // Performance Graph Properties
    in-out property <[GraphPoint]> graph_data: [];
    in-out property <string> insights_text: "⚪ System Idle";

    // Diagnostics & Status
    in-out property <string> smart_alert_text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> is_processing: false;
    in-out property <string> log_text: "System initialized. Ready.\n";
    in-out property <string> status_msg: "Ready";
    in-out property <string> summary_text: "No files analyzed yet.";
    in-out property <[StandardListViewItem]> file_list: [];

    // Right Display Switcher & Visualizer State
    in-out property <int> right_display_mode: 0; // 0 = Tree View, 1 = RAID-0 Map, 2 = Perf Monitor
    in-out property <[StripeBlockUI]> visualizer_blocks: [];
    in-out property <int> selected_block_idx: -1;
    in-out property <int> density_mode_idx: 0;

    // Callbacks
    callback profile_selected(int);
    callback create_profile();
    callback delete_profile();
    callback mode_switched(int);

    // Paradigm 1 Callbacks
    callback browse_primary_folder() -> string;
    callback primary_folder_changed(string);
    callback add_target_drive();
    callback clear_target_drives();
    callback consolidate_target_drive();
    callback auto_detect_threshold(string, string);
    callback auto_detect_pool_size();
    callback verify_integrity(string);
    callback preview_striping(string, int, string, string, bool, bool, bool);
    callback apply_striping(string, int, string, string, bool, bool, bool);
    callback revert_striping(string);

    // Paradigm 2 Callbacks
    callback add_pool_member();
    callback clear_pool_members();
    callback pool_policy_switched(int);
    callback pool_stripe_changed(int);
    callback auto_detect_ram_cache();
    callback mount_pool(string, string, int, bool, float);
    callback unmount_pool();
    callback refresh_pool_index();

    callback scan_drives();
    callback run_benchmark();
    callback auto_start_toggled(bool);
    callback block_clicked(int);
    callback copy_ai_report();
    callback set_graph_window(int);

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // TOP HEADER
        Rectangle {
            height: 48px;
            background: Theme.surface-dark;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Text {
                        text: "SYMSTRIPE STUDIO - HIGH-THROUGHPUT STORAGE ACCELERATOR";
                        font-size: 12px;
                        font-weight: 800;
                        color: Theme.text-bright;
                    }

                    Text {
                        text: "Multi-Spindle I/O, Unreal Engine 5 IoStore Stream Optimizer, and Zstd ATG VFS Pools";
                        font-size: 10px;
                        color: Theme.accent-cyan;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                CustomButton {
                    text: "Run Speed Benchmark";
                    primary-color: Theme.accent-amber;
                    enabled: !root.is_processing;
                    clicked => { root.run_benchmark(); }
                }

                CustomButton {
                    text: "Scan S.M.A.R.T. Disks";
                    primary-color: Theme.border-card;
                    clicked => { root.scan_drives(); }
                }
            }
        }

        if root.smart_alert_text != "": Rectangle {
            height: 30px;
            background: #3d1414;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.primary;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;
                Text {
                    text: root.smart_alert_text;
                    font-size: 11px;
                    font-weight: 700;
                    color: #ff8a80;
                    vertical-alignment: center;
                }
            }
        }

        // MAIN WORKSPACE
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // LEFT CONTROL PANEL
            Rectangle {
                width: 480px;
                background: Theme.surface-dark;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: start;

                        Card {
                            title: "ACTIVE STORAGE PROFILE";
                            header-color: Theme.accent-blue;

                            HorizontalLayout {
                                spacing: 6px;
                                height: 30px;
                                ComboBox {
                                    model: root.profile_names;
                                    enabled: !root.is_pool_mounted && !root.is_processing;
                                    current-index <=> root.active_profile_idx;
                                    selected(val) => { root.profile_selected(root.active_profile_idx); }
                                }

                                CustomButton {
                                    text: "+ New";
                                    primary-color: Theme.accent-blue;
                                    enabled: !root.is_pool_mounted && !root.is_processing;
                                    clicked => { root.create_profile(); }
                                }

                                CustomButton {
                                    text: "Del";
                                    primary-color: Theme.primary;
                                    enabled: !root.is_pool_mounted && !root.is_processing;
                                    clicked => { root.delete_profile(); }
                                }
                            }
                        }

                        Card {
                            title: "STORAGE ACCELERATION ARCHITECTURE";
                            header-color: Theme.accent-purple;

                            HorizontalLayout {
                                spacing: 8px;
                                height: 32px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.active_mode_idx == 0 ? Theme.accent-emerald : Theme.surface-nested;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.active_mode_idx == 0 ? #4ade80 : Theme.border-card;
                                    Text {
                                        text: "🎮 In-Place Game Optimizer";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.active_mode_idx == 0 ? Theme.text-bright : Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                        clicked => { root.active_mode_idx = 0; root.mode_switched(0); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.active_mode_idx == 1 ? Theme.accent-purple : Theme.surface-nested;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.active_mode_idx == 1 ? #c084fc : Theme.border-card;
                                    Text {
                                        text: "💽 Virtual Storage Pool (Z:)";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.active_mode_idx == 1 ? Theme.text-bright : Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                        clicked => { root.active_mode_idx = 1; root.mode_switched(1); }
                                    }
                                }
                            }
                        }

                        // PARADIGM 1: IN-PLACE GAME OPTIMIZER
                        if root.active_mode_idx == 0: VerticalLayout {
                            spacing: 12px;

                            Card {
                                title: "PRIMARY DIRECTORY (ORIGINAL GAME ROOT)";
                                header-color: Theme.accent-blue;

                                HorizontalLayout {
                                    spacing: 5px;
                                    height: 30px;
                                    LineEdit {
                                        text <=> root.primary_path;
                                        placeholder-text: "E:\\Games\\GameTitle";
                                        enabled: !root.is_processing;
                                        edited(val) => { root.primary_folder_changed(val); }
                                    }

                                    CustomButton {
                                        text: "...";
                                        primary-color: Theme.border-focus;
                                        enabled: !root.is_processing;
                                        clicked => { root.primary_path = root.browse_primary_folder(); }
                                    }
                                }
                            }

                            Card {
                                title: "SECONDARY TARGET DRIVES (DESTINATION SPINDLES)";
                                header-color: Theme.accent-amber;

                                VerticalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 60px;
                                        background: Theme.surface-nested;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.border-card;
                                        ListView {
                                            for item in root.target_drives_list: Rectangle {
                                                height: 20px;
                                                background: ta_td.has-hover ? Theme.surface-hover : transparent;
                                                border-radius: 2px;
                                                ta_td := TouchArea { }

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    alignment: start;
                                                    Text {
                                                        text: item.text;
                                                        font-family: "Consolas";
                                                        font-size: 11px;
                                                        color: Theme.accent-amber;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        CustomButton {
                                            text: "+ Add Target Drive";
                                            primary-color: Theme.accent-amber;
                                            enabled: !root.is_processing;
                                            clicked => { root.add_target_drive(); }
                                        }

                                        CustomButton {
                                            text: "Consolidate";
                                            primary-color: Theme.accent-amber;
                                            enabled: root.is_already_striped && !root.is_processing;
                                            clicked => { root.consolidate_target_drive(); }
                                        }

                                        CustomButton {
                                            text: "Clear";
                                            primary-color: Theme.border-card;
                                            enabled: !root.is_processing;
                                            clicked => { root.clear_target_drives(); }
                                        }
                                    }
                                }
                            }

                            Card {
                                title: "STREAMING ENGINE RULES & COMPATIBILITY";
                                header-color: Theme.accent-emerald;

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Min Archive Size (MB):";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    LineEdit {
                                        width: 65px;
                                        text <=> root.min_size_mb_text;
                                        enabled: !root.is_processing;
                                    }

                                    CustomButton {
                                        text: "Auto";
                                        primary-color: Theme.accent-blue;
                                        enabled: !root.is_processing;
                                        clicked => { root.auto_detect_threshold(root.primary_path, root.exclusions_text); }
                                    }
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Excluded Extensions:";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    LineEdit {
                                        text <=> root.exclusions_text;
                                        placeholder-text: "exe, dll, pdb, utoc, sig...";
                                        enabled: !root.is_processing;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    CheckBox {
                                        text: "Unreal Engine IoStore Mode (Pin .utoc/.sig to Primary, offload .ucas)";
                                        checked <=> root.ue5_safe_mode;
                                        enabled: !root.is_processing;
                                    }

                                    CheckBox {
                                        text: "Retain local .backup files on Primary Drive (Safe Mode)";
                                        checked <=> root.keep_backup;
                                        enabled: !root.is_processing;
                                    }

                                    CheckBox {
                                        text: "Aggressive Media Offload (Force .bik, .mp4, audio to secondary drives)";
                                        checked <=> root.aggressive_media;
                                        enabled: !root.is_processing;
                                    }
                                }

                                Rectangle {
                                    background: #2b1f0e;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.accent-amber;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        Text {
                                            text: "⚠️ ADVISORY: STEAM & EPIC GAME VERIFICATION";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #fbbf24;
                                        }

                                        Text {
                                            text: "• Do not run launcher 'Verify integrity' while files are striped (launchers may replace symlinks with full downloads).\n• Temporarily pause automatic background updates for optimized titles.\n• Always click 'Revert All to Primary' prior to applying official game patches!";
                                            font-size: 10px;
                                            color: #fde68a;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    CustomButton {
                                        text: "Analyze & Preview Distribution (Dry Run)";
                                        primary-color: #4a5d6e;
                                        enabled: !root.is_processing && !root.is_already_striped;
                                        clicked => {
                                            root.preview_striping(root.primary_path, root.min_size_mb_text.to-float(), root.exclusions_text, root.media_extensions_text, root.keep_backup, root.aggressive_media, root.ue5_safe_mode);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    CustomButton {
                                        text: "Distribute Across Drives";
                                        primary-color: Theme.accent-emerald;
                                        enabled: !root.is_processing && !root.is_already_striped;
                                        clicked => {
                                            root.apply_striping(root.primary_path, root.min_size_mb_text.to-float(), root.exclusions_text, root.media_extensions_text, root.keep_backup, root.aggressive_media, root.ue5_safe_mode);
                                        }
                                    }

                                    CustomButton {
                                        text: "Revert All to Primary";
                                        primary-color: root.is_already_striped ? Theme.accent-amber : Theme.accent-blue;
                                        enabled: !root.is_processing;
                                        clicked => {
                                            root.revert_striping(root.primary_path);
                                        }
                                    }
                                }
                            }
                        }

                        // PARADIGM 2: VIRTUAL STORAGE POOL (VFS)
                        if root.active_mode_idx == 1: VerticalLayout {
                            spacing: 12px;

                            Card {
                                title: "STORAGE POOL MEMBERS (FOLDERS ACROSS DISKS)";
                                header-color: Theme.accent-purple;

                                VerticalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        height: 80px;
                                        background: Theme.surface-nested;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.border-card;
                                        ListView {
                                            for item in root.pool_members_list: Rectangle {
                                                height: 20px;
                                                background: ta_pm.has-hover ? Theme.surface-hover : transparent;
                                                border-radius: 2px;
                                                ta_pm := TouchArea { }

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    alignment: start;
                                                    Text {
                                                        text: item.text;
                                                        font-family: "Consolas";
                                                        font-size: 11px;
                                                        color: Theme.accent-purple;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        CustomButton {
                                            text: "+ Add Pool Folder (e.g., E:\\Pool, F:\\Pool)";
                                            primary-color: Theme.accent-purple;
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.add_pool_member(); }
                                        }

                                        CustomButton {
                                            text: "Clear";
                                            primary-color: Theme.border-card;
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.clear_pool_members(); }
                                        }
                                    }
                                }
                            }

                            Card {
                                title: "POOL ALLOCATION & STRIPING STRATEGY";
                                header-color: Theme.accent-purple;

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 30px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.pool_policy_idx == 0 ? Theme.accent-blue : Theme.surface-nested;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: root.pool_policy_idx == 0 ? #60a5fa : Theme.border-card;
                                        Text {
                                            text: "📦 Capacity (JBOD Merge)";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.pool_policy_idx == 0 ? Theme.text-bright : Theme.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_policy_idx = 0; root.pool_policy_switched(0); }
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.pool_policy_idx == 1 ? Theme.accent-purple : Theme.surface-nested;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: root.pool_policy_idx == 1 ? #c084fc : Theme.border-card;
                                        Text {
                                            text: "⚡ Speed (RAID-0 + RAM Cache)";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.pool_policy_idx == 1 ? Theme.text-bright : Theme.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_policy_idx = 1; root.pool_policy_switched(1); }
                                        }
                                    }
                                }

                                if root.pool_policy_idx == 1: HorizontalLayout {
                                    height: 30px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "HDD Stripe Block:";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    Rectangle {
                                        width: 55px;
                                        height: 26px;
                                        background: root.pool_stripe_mb == 16 ? Theme.accent-purple : Theme.surface-nested;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.pool_stripe_mb == 16 ? #c084fc : Theme.border-card;
                                        Text {
                                            text: "16 MB";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.text-bright;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_stripe_mb = 16; root.pool_stripe_changed(16); }
                                        }
                                    }

                                    Rectangle {
                                        width: 95px;
                                        height: 26px;
                                        background: root.pool_stripe_mb == 64 ? Theme.accent-emerald : Theme.surface-nested;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.pool_stripe_mb == 64 ? #34d399 : Theme.border-card;
                                        Text {
                                            text: "★ 64 MB (HDD)";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.text-bright;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_stripe_mb = 64; root.pool_stripe_changed(64); }
                                        }
                                    }

                                    Rectangle {
                                        width: 65px;
                                        height: 26px;
                                        background: root.pool_stripe_mb == 128 ? Theme.accent-purple : Theme.surface-nested;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.pool_stripe_mb == 128 ? #c084fc : Theme.border-card;
                                        Text {
                                            text: "128 MB";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.text-bright;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_stripe_mb = 128; root.pool_stripe_changed(128); }
                                        }
                                    }

                                    Rectangle {
                                        width: 65px;
                                        height: 26px;
                                        background: root.pool_stripe_mb == 256 ? Theme.accent-purple : Theme.surface-nested;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.pool_stripe_mb == 256 ? #c084fc : Theme.border-card;
                                        Text {
                                            text: "256 MB";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.text-bright;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        TouchArea {
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                            clicked => { root.pool_stripe_mb = 256; root.pool_stripe_changed(256); }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Virtual Mount Drive:";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    LineEdit {
                                        width: 45px;
                                        text <=> root.pool_mount_point;
                                        placeholder-text: "Z:";
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                    }

                                    Text {
                                        text: "Size (GB):";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    LineEdit {
                                        width: 65px;
                                        text <=> root.pool_custom_size_gb_text;
                                        placeholder-text: "0 (Auto)";
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                    }

                                    CustomButton {
                                        text: "Auto";
                                        primary-color: Theme.accent-blue;
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                        clicked => { root.auto_detect_pool_size(); }
                                    }
                                }

                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "RAM Cache Budget (MB):";
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: Theme.text-main;
                                    }

                                    LineEdit {
                                        width: 75px;
                                        text <=> root.pool_ram_cache_mb_text;
                                        placeholder-text: "0 (Auto)";
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                    }

                                    CustomButton {
                                        text: "Auto";
                                        primary-color: Theme.accent-emerald;
                                        enabled: !root.is_pool_mounted && !root.is_processing;
                                        clicked => { root.auto_detect_ram_cache(); }
                                    }

                                    Text {
                                        text: "High-speed RAM buffer";
                                        vertical-alignment: center;
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    CustomButton {
                                        text: root.is_pool_mounted ? "🛑 Stop & Unmount Pool" : "🚀 Mount Virtual Storage Pool (" + root.pool_mount_point + ")";
                                        primary-color: root.is_pool_mounted ? Theme.primary : Theme.accent-purple;
                                        enabled: !root.is_processing;
                                        clicked => {
                                            if root.is_pool_mounted {
                                                root.unmount_pool();
                                            } else {
                                                root.mount_pool(root.pool_mount_point, root.pool_custom_size_gb_text, root.vfs_codec_index, root.tiered_storage_enabled, root.pool_ram_cache_mb_text.to-float());
                                            }
                                        }
                                    }

                                    if root.is_pool_mounted: CustomButton {
                                        text: "🔄 Rescan";
                                        primary-color: Theme.accent-blue;
                                        clicked => { root.refresh_pool_index(); }
                                    }
                                }

                                Card {
                                    title: "ON-THE-FLY COMPRESSION & ASSET TIERING";
                                    header-color: Theme.accent-purple;

                                    VerticalLayout {
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Compression Codec:";
                                                color: Theme.text-main;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }

                                            ComboBox {
                                                width: 220px;
                                                model: ["LZ4 (High Speed)", "Zstd ATG (256K Cache Bound)", "Store (Raw)"];
                                                current-index <=> root.vfs_codec_index;
                                                enabled: !root.is_pool_mounted && !root.is_processing;
                                            }
                                        }

                                        CheckBox {
                                            text: "Tiered Storage (Keep IoStore metadata on Drive 1, bulk on secondary)";
                                            checked <=> root.tiered_storage_enabled;
                                            enabled: !root.is_pool_mounted && !root.is_processing;
                                        }

                                        CheckBox {
                                            text: "Auto-Start Virtual Pool with Windows (Silent Boot)";
                                            checked <=> root.auto_start_enabled;
                                            toggled => { root.auto_start_toggled(self.checked); }
                                        }

                                        Text {
                                            text: "Mount drive " + root.pool_mount_point + " as your game target. DirectStorage-grade Zstd ATG caps internal sliding memory to 256 KB, ensuring zero L3 cache thrashing and sustained read bandwidth on mechanical disks.";
                                            font-size: 11px;
                                            color: Theme.text-muted;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT DISPLAY PANEL (FILE TREE VIEW & RAID-0 BLOCK MAP & PERFORMANCE GRAPH)
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;

                Rectangle {
                    vertical-stretch: 5;
                    background: Theme.surface-dark;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 140px;
                                    height: 26px;
                                    background: root.right_display_mode == 0 ? Theme.accent-blue : Theme.surface-nested;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.right_display_mode == 0 ? #60a5fa : Theme.border-card;
                                    Text {
                                        text: "📁 File Tree View";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.right_display_mode == 0 ? Theme.text-bright : Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.right_display_mode = 0; }
                                    }
                                }

                                Rectangle {
                                    width: 170px;
                                    height: 26px;
                                    background: root.right_display_mode == 1 ? Theme.accent-purple : Theme.surface-nested;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.right_display_mode == 1 ? #c084fc : Theme.border-card;
                                    Text {
                                        text: "💽 RAID-0 Physical Map";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.right_display_mode == 1 ? Theme.text-bright : Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.right_display_mode = 1;
                                            if (root.selected_block_idx < 0 && root.visualizer_blocks.length > 0) {
                                                root.selected_block_idx = 0;
                                                root.block_clicked(0);
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 150px;
                                    height: 26px;
                                    background: root.right_display_mode == 2 ? Theme.accent-emerald : Theme.surface-nested;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.right_display_mode == 2 ? #34d399 : Theme.border-card;
                                    Text {
                                        text: "📈 Performance Monitor";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.right_display_mode == 2 ? Theme.text-bright : Theme.text-muted;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.right_display_mode = 2; }
                                    }
                                }
                            }

                            if root.right_display_mode == 0: Text {
                                text: root.summary_text;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.accent-emerald;
                                vertical-alignment: center;
                            }

                            if root.right_display_mode == 1: HorizontalLayout {
                                spacing: 8px;
                                ComboBox {
                                    width: 180px;
                                    model: [
                                        "Density: Auto (Fit)",
                                        "Density: Nano (3px)",
                                        "Density: Micro (5px)",
                                        "Density: Compact (9px)",
                                        "Density: Normal (16px)"
                                    ];
                                    current-index <=> root.density_mode_idx;
                                }
                            }
                        }

                        if root.right_display_mode == 0: ListView {
                            for item in root.file_list: Rectangle {
                                height: 22px;
                                background: ta_row.has-hover ? Theme.surface-hover : transparent;
                                border-radius: 2px;
                                ta_row := TouchArea { }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: start;
                                    Text {
                                        text: item.text;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        if root.right_display_mode == 1: BlockMap {
                            blocks: root.visualizer_blocks;
                            selected_block_idx <=> root.selected_block_idx;
                            density_mode_idx <=> root.density_mode_idx;
                            block_clicked(idx) => { root.block_clicked(idx); }
                        }

                        if root.right_display_mode == 2: PerformanceGraph {
                            data: root.graph_data;
                            insights_text: root.insights_text;
                            copy_ai_report => { root.copy_ai_report(); }
                            set_window(w) => { root.set_graph_window(w); }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 3;
                    background: Theme.surface-nested;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-card;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "SYSTEM & EXECUTION LOG";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent-amber;
                        }

                        TextEdit {
                            text <=> root.log_text;
                            read-only: true;
                            font-family: "Consolas";
                            font-size: 11px;
                        }
                    }
                }

                TelemetryPanel {
                    drive1_label: root.drive1_label;
                    drive2_label: root.drive2_label;
                    drive1_speed_text: root.drive1_speed_text;
                    drive2_speed_text: root.drive2_speed_text;
                    drive1_load_pct: root.drive1_load_pct;
                    drive2_load_pct: root.drive2_load_pct;
                    total_io_text: root.total_io_text;
                    is_io_active: root.is_io_active;
                    cache_hit_rate_text: root.cache_hit_rate_text;
                    saved_space_text: root.saved_space_text;
                }
            }
        }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 34px;
            background: Theme.surface-dark;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 3px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.status_msg;
                        color: root.is_processing ? Theme.accent-amber : Theme.accent-emerald;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 3px;
                    background: Theme.app-bg;
                    border-radius: 1px;
                    Rectangle {
                        x: 0px;
                        width: parent.width * root.progress;
                        height: parent.height;
                        background: root.is_processing ? Theme.accent-amber : Theme.accent-emerald;
                        border-radius: 1px;
                    }
                }
            }
        }
    }
}

import {
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    TextEdit,
    ListView,
} from "std-widgets.slint";

component CustomButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> primary-color: #3e6a90;
    callback clicked;

    height: 30px;

    Rectangle {
        background: !root.enabled ? #202124 : (ta.has-hover ? root.primary-color.brighter(12%) : root.primary-color);
        border-radius: 4px;
        border-width: 1px;
        border-color: !root.enabled ? #2b2d31 : root.primary-color.darker(10%);

        Text {
            text: root.text;
            color: !root.enabled ? #808080 : #ffffff;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component SectionHeader {
    in property <string> title;
    in property <color> title-color: #949ba4;

    height: 22px;
    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.title;
            font-size: 11px;
            font-weight: 700;
            color: root.title-color;
        }

        Rectangle {
            height: 1px;
            background: #353535;
        }
    }
}

export component AppWindow inherits Window {
    title: "SymStripe - Multi-Drive Storage Accelerator";
    min-width: 1040px;
    min-height: 820px;
    preferred-width: 1120px;
    preferred-height: 860px;
    background: #141414;

    // Profile state
    in-out property <[string]> profile_names: ["Default Profile"];
    in-out property <int> active_profile_idx: 0;

    // Top Paradigm Architecture: 0 = In-Place Optimizer, 1 = Virtual Storage Pool
    in-out property <int> active_mode_idx: 0;

    // Paradigm 1: In-Place Game Optimizer Properties
    in-out property <string> primary_path: "";
    in-out property <[StandardListViewItem]> target_drives_list: [];
    in-out property <string> min_size_mb_text: "50";
    in-out property <string> exclusions_text: "exe, dll, pdb, utoc, sig";
    in-out property <string> media_extensions_text: "bik, bk2, mp4, fsb, pck, wem";
    in-out property <bool> keep_backup: true;
    in-out property <bool> aggressive_media: false;
    in-out property <bool> ue5_safe_mode: true;
    in-out property <bool> is_already_striped: false;

    // Paradigm 2: Virtual Storage Pool Properties
    in-out property <[StandardListViewItem]> pool_members_list: [];
    in-out property <int> pool_policy_idx: 1; // 0 = Capacity (JBOD), 1 = Speed (RAID-0)
    in-out property <int> pool_stripe_mb: 16;
    in-out property <string> pool_mount_point: "Z:";
    in-out property <string> pool_custom_size_gb_text: "0";
    in-out property <bool> is_pool_mounted: false;

    // Diagnostics & Status
    in-out property <string> smart_alert_text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> is_processing: false;
    in-out property <string> log_text: "System ready. Select paradigm to begin.\n";
    in-out property <string> status_msg: "Ready";
    in-out property <string> summary_text: "No files analyzed yet.";
    in-out property <[StandardListViewItem]> file_list: [];

    // Callbacks
    callback profile_selected(int);
    callback create_profile();
    callback delete_profile();
    callback mode_switched(int);

    // Paradigm 1 Callbacks
    callback browse_primary_folder() -> string;
    callback primary_folder_changed(string);
    callback add_target_drive();
    callback clear_target_drives();
    callback consolidate_target_drive();
    callback auto_detect_threshold(string, string);
    callback auto_detect_pool_size();
    callback verify_integrity(string);
    callback preview_striping(string, int, string, string, bool, bool, bool);
    callback apply_striping(string, int, string, string, bool, bool, bool);
    callback revert_striping(string);

    // Paradigm 2 Callbacks
    callback add_pool_member();
    callback clear_pool_members();
    callback pool_policy_switched(int);
    callback pool_stripe_changed(int);
    callback mount_pool(string, string);
    callback unmount_pool();

    callback scan_drives();
    callback run_benchmark();

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // TOP HEADER
        Rectangle {
            height: 44px;
            background: #1e1f22;
            border-radius: 4px;
            border-width: 1px;
            border-color: #2b2d31;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SYMSTRIPE PARALLEL ACCELERATOR";
                        font-size: 12px;
                        font-weight: 800;
                        color: #ffffff;
                    }

                    Text {
                        text: "Multi-Spindle I/O, Engine Junctions & Extent-Striped Virtual Pools";
                        font-size: 10px;
                        color: #808080;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    CustomButton {
                        text: "Run Speed Benchmark";
                        width: 150px;
                        primary-color: #d97706;
                        enabled: !root.is_processing;
                        clicked => { root.run_benchmark(); }
                    }

                    CustomButton {
                        text: "Scan S.M.A.R.T. & Disks";
                        width: 150px;
                        primary-color: #2b2d31;
                        clicked => { root.scan_drives(); }
                    }
                }
            }
        }

        if root.smart_alert_text != "": Rectangle {
            height: 30px;
            background: #3d1414;
            border-radius: 4px;
            border-width: 1px;
            border-color: #e53935;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;
                Text {
                    text: root.smart_alert_text;
                    font-size: 11px;
                    font-weight: 700;
                    color: #ff8a80;
                    vertical-alignment: center;
                }
            }
        }

        // MAIN WORKSPACE
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // LEFT CONTROL PANEL
            Rectangle {
                width: 500px;
                background: #1e1f22;
                border-radius: 4px;
                border-width: 1px;
                border-color: #2b2d31;

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;
                        alignment: start;

                        // Section 0: Active Storage Profile
                        SectionHeader {
                            title: "ACTIVE STORAGE PROFILE";
                            title-color: #3e6a90;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 30px;
                            ComboBox {
                                model: root.profile_names;
                                current-index <=> root.active_profile_idx;
                                selected(val) => { root.profile_selected(root.active_profile_idx); }
                            }

                            CustomButton {
                                text: "+ New";
                                width: 50px;
                                clicked => { root.create_profile(); }
                            }

                            CustomButton {
                                text: "Del";
                                width: 40px;
                                primary-color: #c94040;
                                clicked => { root.delete_profile(); }
                            }
                        }

                        // Section 1: PARADIGM ARCHITECTURE SELECTOR
                        SectionHeader {
                            title: "STORAGE ACCELERATION PARADIGM";
                            title-color: #a855f7;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.active_mode_idx == 0 ? #23a55a : #141414;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.active_mode_idx == 0 ? #4ade80 : #2b2d31;
                                Text {
                                    text: "🎮 In-Place Game Optimizer";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_mode_idx == 0 ? #ffffff : #949ba4;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.active_mode_idx = 0; root.mode_switched(0); }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.active_mode_idx == 1 ? #7e22ce : #141414;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.active_mode_idx == 1 ? #c084fc : #2b2d31;
                                Text {
                                    text: "💽 Virtual Storage Pool (Z:)";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_mode_idx == 1 ? #ffffff : #949ba4;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.active_mode_idx = 1; root.mode_switched(1); }
                                }
                            }
                        }

                        // ==========================================
                        // PARADIGM 1: IN-PLACE GAME OPTIMIZER
                        // ==========================================
                        if root.active_mode_idx == 0: VerticalLayout {
                            spacing: 12px;

                            SectionHeader {
                                title: "PRIMARY DRIVE (GAME SOURCE DIRECTORY)";
                                title-color: #3e6a90;
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                height: 30px;
                                LineEdit {
                                    text <=> root.primary_path;
                                    placeholder-text: "E:\\Games\\Gears of War E-Day\\GoWEDay";
                                    edited(val) => { root.primary_folder_changed(val); }
                                }

                                CustomButton {
                                    text: "...";
                                    width: 32px;
                                    clicked => { root.primary_path = root.browse_primary_folder(); }
                                }
                            }

                            SectionHeader {
                                title: "SECONDARY TARGET DRIVES (DESTINATIONS)";
                                title-color: #f0b132;
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 60px;
                                    background: #141414;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #2b2d31;
                                    ListView {
                                        for item in root.target_drives_list: Rectangle {
                                            height: 20px;
                                            background: ta_td.has-hover ? #202226 : transparent;
                                            border-radius: 2px;
                                            ta_td := TouchArea { }

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                alignment: start;
                                                Text {
                                                    text: item.text;
                                                    font-family: "Consolas";
                                                    font-size: 11px;
                                                    color: #f0b132;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    CustomButton {
                                        text: "+ Add Target (e.g. F:\\zzz)";
                                        primary-color: #f0b132;
                                        clicked => { root.add_target_drive(); }
                                    }

                                    CustomButton {
                                        text: "Consolidate";
                                        primary-color: #d97706;
                                        enabled: root.is_already_striped && !root.is_processing;
                                        clicked => { root.consolidate_target_drive(); }
                                    }

                                    CustomButton {
                                        text: "Clear";
                                        primary-color: #2b2d31;
                                        width: 60px;
                                        clicked => { root.clear_target_drives(); }
                                    }
                                }
                            }

                            SectionHeader {
                                title: "STRIPING RULES & COMPATIBILITY";
                                title-color: #23a55a;
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Min Archive Size (MB):";
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    color: #dcddde;
                                }

                                LineEdit {
                                    width: 65px;
                                    text <=> root.min_size_mb_text;
                                }

                                CustomButton {
                                    text: "Auto";
                                    width: 50px;
                                    primary-color: #3e6a90;
                                    enabled: !root.is_processing;
                                    clicked => { root.auto_detect_threshold(root.primary_path, root.exclusions_text); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Exclude Extensions:";
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    color: #dcddde;
                                }

                                LineEdit {
                                    text <=> root.exclusions_text;
                                    placeholder-text: "exe, dll, pdb, utoc, sig...";
                                }
                            }

                            VerticalLayout {
                                spacing: 5px;
                                CheckBox {
                                    text: "Unreal Engine / DirectStorage Safe Mode (Subfolder Junctions)";
                                    checked <=> root.ue5_safe_mode;
                                }

                                CheckBox {
                                    text: "Keep local .backup on Drive 1 (Safe Mode)";
                                    checked <=> root.keep_backup;
                                }

                                CheckBox {
                                    text: "Aggressive Media Offload (Force media to targets)";
                                    checked <=> root.aggressive_media;
                                }
                            }

                            HorizontalLayout {
                                CustomButton {
                                    text: "Analyze & Preview Split (Dry Run)";
                                    primary-color: #4a5d6e;
                                    enabled: !root.is_processing && !root.is_already_striped;
                                    clicked => {
                                        root.preview_striping(root.primary_path, root.min_size_mb_text.to-float(), root.exclusions_text, root.media_extensions_text, root.keep_backup, root.aggressive_media, root.ue5_safe_mode);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                CustomButton {
                                    text: "Distribute Across Drives";
                                    primary-color: #23a55a;
                                    enabled: !root.is_processing && !root.is_already_striped;
                                    clicked => {
                                        root.apply_striping(root.primary_path, root.min_size_mb_text.to-float(), root.exclusions_text, root.media_extensions_text, root.keep_backup, root.aggressive_media, root.ue5_safe_mode);
                                    }
                                }

                                CustomButton {
                                    text: "Revert All to Primary";
                                    primary-color: root.is_already_striped ? #f0b132 : #3e6a90;
                                    enabled: !root.is_processing;
                                    clicked => {
                                        root.revert_striping(root.primary_path);
                                    }
                                }
                            }
                        }

                        // ==========================================
                        // PARADIGM 2: VIRTUAL STORAGE POOL (VFS)
                        // ==========================================
                        if root.active_mode_idx == 1: VerticalLayout {
                            spacing: 12px;

                            SectionHeader {
                                title: "STORAGE POOL MEMBERS (FOLDERS ACROSS DISKS)";
                                title-color: #a855f7;
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 80px;
                                    background: #141414;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #2b2d31;
                                    ListView {
                                        for item in root.pool_members_list: Rectangle {
                                            height: 20px;
                                            background: ta_pm.has-hover ? #202226 : transparent;
                                            border-radius: 2px;
                                            ta_pm := TouchArea { }

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                alignment: start;
                                                Text {
                                                    text: item.text;
                                                    font-family: "Consolas";
                                                    font-size: 11px;
                                                    color: #c084fc;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    CustomButton {
                                        text: "+ Add Pool Folder (e.g. E:\\Pool, F:\\Pool)";
                                        primary-color: #7e22ce;
                                        clicked => { root.add_pool_member(); }
                                    }

                                    CustomButton {
                                        text: "Clear";
                                        primary-color: #2b2d31;
                                        width: 60px;
                                        clicked => { root.clear_pool_members(); }
                                    }
                                }
                            }

                            SectionHeader {
                                title: "POOL ALLOCATION STRATEGY";
                                title-color: #a855f7;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                height: 30px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.pool_policy_idx == 0 ? #3e6a90 : #141414;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.pool_policy_idx == 0 ? #60a5fa : #2b2d31;
                                    Text {
                                        text: "📦 Capacity (JBOD Merge)";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.pool_policy_idx == 0 ? #ffffff : #949ba4;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.pool_policy_idx = 0; root.pool_policy_switched(0); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: root.pool_policy_idx == 1 ? #7e22ce : #141414;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: root.pool_policy_idx == 1 ? #c084fc : #2b2d31;
                                    Text {
                                        text: "⚡ Speed (RAID-0 Striping)";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.pool_policy_idx == 1 ? #ffffff : #949ba4;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.pool_policy_idx = 1; root.pool_policy_switched(1); }
                                    }
                                }
                            }

                            if root.pool_policy_idx == 1: HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Stripe Extent Block Size:";
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    color: #dcddde;
                                }

                                Rectangle {
                                    width: 55px;
                                    height: 26px;
                                    background: root.pool_stripe_mb == 4 ? #7e22ce : #141414;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.pool_stripe_mb == 4 ? #c084fc : #2b2d31;
                                    Text {
                                        text: "4 MB";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.pool_stripe_mb = 4; root.pool_stripe_changed(4); }
                                    }
                                }

                                Rectangle {
                                    width: 55px;
                                    height: 26px;
                                    background: root.pool_stripe_mb == 16 ? #7e22ce : #141414;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.pool_stripe_mb == 16 ? #c084fc : #2b2d31;
                                    Text {
                                        text: "16 MB";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.pool_stripe_mb = 16; root.pool_stripe_changed(16); }
                                    }
                                }

                                Rectangle {
                                    width: 55px;
                                    height: 26px;
                                    background: root.pool_stripe_mb == 64 ? #7e22ce : #141414;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.pool_stripe_mb == 64 ? #c084fc : #2b2d31;
                                    Text {
                                        text: "64 MB";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.pool_stripe_mb = 64; root.pool_stripe_changed(64); }
                                    }
                                }
                            }

                            // Quota and Drive Letter Section
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: "Virtual Mount Drive:";
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    color: #dcddde;
                                }

                                LineEdit {
                                    width: 45px;
                                    text <=> root.pool_mount_point;
                                    placeholder-text: "Z:";
                                    enabled: !root.is_pool_mounted;
                                }

                                Text {
                                    text: "Size (GB):";
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    color: #dcddde;
                                }

                                LineEdit {
                                    width: 65px;
                                    text <=> root.pool_custom_size_gb_text;
                                    placeholder-text: "0 (Auto)";
                                    enabled: !root.is_pool_mounted;
                                }

                                CustomButton {
                                    text: "Auto";
                                    width: 40px;
                                    primary-color: #3e6a90;
                                    enabled: !root.is_pool_mounted;
                                    clicked => { root.auto_detect_pool_size(); }
                                }
                            }

                            HorizontalLayout {
                                CustomButton {
                                    text: root.is_pool_mounted ? "🛑 Stop & Unmount Virtual Pool" : "🚀 Mount Virtual Storage Pool (" + root.pool_mount_point + ")";
                                    primary-color: root.is_pool_mounted ? #c94040 : #7e22ce;
                                    enabled: !root.is_processing;
                                    clicked => {
                                        if root.is_pool_mounted {
                                            root.unmount_pool();
                                        } else {
                                            root.mount_pool(root.pool_mount_point, root.pool_custom_size_gb_text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT DISPLAY PANEL
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;

                Rectangle {
                    vertical-stretch: 6;
                    background: #1e1f22;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2b2d31;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "STORAGE TREE VIEW (PHYSICAL ALLOCATION)";
                                font-size: 11px;
                                font-weight: 700;
                                color: #949ba4;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.summary_text;
                                font-size: 10px;
                                font-weight: 700;
                                color: #23a55a;
                                vertical-alignment: center;
                            }
                        }

                        ListView {
                            for item in root.file_list: Rectangle {
                                height: 22px;
                                background: ta_row.has-hover ? #26282d : transparent;
                                border-radius: 2px;
                                ta_row := TouchArea { }

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: start;
                                    Text {
                                        text: item.text;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        color: #dcddde;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 4;
                    background: #18191b;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #2b2d31;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "TERMINAL EXECUTION LOG";
                            font-size: 10px;
                            font-weight: 700;
                            color: #e59535;
                        }

                        TextEdit {
                            text <=> root.log_text;
                            read-only: true;
                            font-family: "Consolas";
                            font-size: 11px;
                        }
                    }
                }
            }
        }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 34px;
            background: #1e1f22;
            border-radius: 4px;
            border-width: 1px;
            border-color: #2b2d31;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 3px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.status_msg;
                        color: root.is_processing ? #f0b132 : #4CAF50;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 3px;
                    background: #141414;
                    border-radius: 1px;
                    Rectangle {
                        x: 0px;
                        width: parent.width * root.progress;
                        height: parent.height;
                        background: root.is_processing ? #f0b132 : #23a55a;
                        border-radius: 1px;
                    }
                }
            }
        }
    }
}

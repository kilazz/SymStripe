export struct StripeBlockUI {
    id: int,
    label: string,
    file_name: string,
    offset_str: string,
    size_str: string,
    drive_name: string,
    status_str: string,
    color_drive: color,
    is_cached: bool,
}

export global Theme {
    out property <color> app-bg: #141417;
    out property <color> surface-dark: #1A1A1E;
    out property <color> surface-card: #1E1E24;
    out property <color> surface-nested: #141417;
    out property <color> surface-hover: #25252E;
    out property <color> surface-selected: #2D3748;

    out property <color> border-subtle: #27272F;
    out property <color> border-card: #2D2D38;
    out property <color> border-focus: #3B82F6;
    out property <color> divider: #2E2E3A;

    out property <color> primary: #DC2626;
    out property <color> primary-hover: #EF4444;
    out property <color> primary-pressed: #991B1B;
    out property <color> accent-blue: #60A5FA;
    out property <color> accent-cyan: #38BDF8;
    out property <color> accent-emerald: #10B981;
    out property <color> accent-amber: #F59E0B;
    out property <color> accent-purple: #A855F7;
    out property <color> accent-pink: #F472B6;

    out property <color> text-main: #E4E4E7;
    out property <color> text-muted: #9CA3AF;
    out property <color> text-dim: #6B7280;
    out property <color> text-bright: #FFFFFF;
}

export component Card inherits Rectangle {
    in property <string> title;
    in property <color> header-color: Theme.accent-blue;

    background: Theme.surface-card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-card;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 700;
            color: root.header-color;
        }

        @children
    }
}

export component LegendBadge inherits HorizontalLayout {
    in property <color> badge-color;
    in property <string> label;

    spacing: 5px;
    alignment: center;

    Rectangle {
        width: 10px;
        height: 14px;

        Rectangle {
            y: 2px;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: root.badge-color;
        }
    }

    Text {
        text: root.label;
        color: Theme.text-main;
        font-size: 11px;
        vertical-alignment: center;
    }
}

export component CustomButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> primary-color: Theme.primary;
    callback clicked;

    height: 30px;
    min-width: txt.min-width + 24px;
    horizontal-stretch: 0;

    Rectangle {
        background: !root.enabled ? #202124 : (ta.has-hover ? root.primary-color.brighter(12%) : root.primary-color);
        border-radius: 4px;
        border-width: 1px;
        border-color: !root.enabled ? #2b2d31 : root.primary-color.darker(10%);

        txt := Text {
            text: root.text;
            color: !root.enabled ? #808080 : #ffffff;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

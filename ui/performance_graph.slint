import { Theme, GraphPoint, CustomButton } from "theme.slint";

export component PerformanceGraph inherits Rectangle {
    in property <[GraphPoint]> data;
    in property <string> insights_text: "⚪ Idle";
    in-out property <int> time_scale: 60;

    callback copy_ai_report();
    callback set_window(int);

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "📈 PERFORMANCE & BOTTLENECK MONITOR";
                font-size: 11px;
                font-weight: 700;
                color: Theme.accent-cyan;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                CustomButton {
                    text: "60s";
                    primary-color: root.time_scale == 60 ? Theme.accent-blue : Theme.surface-card;
                    clicked => { root.set_window(60); root.time_scale = 60; }
                }

                CustomButton {
                    text: "3m";
                    primary-color: root.time_scale == 180 ? Theme.accent-blue : Theme.surface-card;
                    clicked => { root.set_window(180); root.time_scale = 180; }
                }

                CustomButton {
                    text: "5m";
                    primary-color: root.time_scale == 300 ? Theme.accent-blue : Theme.surface-card;
                    clicked => { root.set_window(300); root.time_scale = 300; }
                }

                Rectangle {
                    width: 10px;
                }

                CustomButton {
                    text: "📋 Copy AI Diagnostics Report";
                    primary-color: Theme.accent-emerald;
                    clicked => { root.copy_ai_report(); }
                }
            }
        }

        // Live Bar Chart Canvas with Grid & Baseline
        Rectangle {
            vertical-stretch: 1;
            background: #101013;
            border-radius: 4px;
            border-width: 1px;
            border-color: #272730;

            // Background Grid Lines
            VerticalLayout {
                padding: 12px;
                alignment: space-between;

                Rectangle {
                    height: 1px;
                    background: #202028;
                    HorizontalLayout {
                        padding-left: 4px;
                        Text {
                            text: "Dynamic Peak Throughput";
                            font-size: 9px;
                            color: #52525B;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #1A1A22;
                    HorizontalLayout {
                        padding-left: 4px;
                        Text {
                            text: "50% Scale";
                            font-size: 9px;
                            color: #3F3F46;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #2E2E3A;
                    HorizontalLayout {
                        padding-left: 4px;
                        Text {
                            text: "0 MB/s Baseline";
                            font-size: 9px;
                            color: #71717A;
                        }
                    }
                }
            }

            // Live Bars Container
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 0px;

                for pt in root.data: Rectangle {
                    horizontal-stretch: 1;

                    // Drive 1 Bar (Blue)
                    Rectangle {
                        y: parent.height * (1.0 - pt.d1_val);
                        height: max(0px, parent.height * pt.d1_val);
                        background: Theme.accent-blue;
                        opacity: 0.85;
                    }

                    // Drive 2 Bar (Purple)
                    Rectangle {
                        y: parent.height * (1.0 - pt.d2_val);
                        height: max(0px, parent.height * pt.d2_val);
                        background: Theme.accent-purple;
                        opacity: 0.7;
                    }

                    // Red Stall Dot (>250ms spike)
                    if pt.is_stall: Rectangle {
                        y: 2px;
                        width: min(4px, parent.width);
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.primary;
                    }
                }
            }

            if root.data.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "📡 PERFORMANCE MONITOR ACTIVE";
                    font-size: 11px;
                    font-weight: 800;
                    color: #4B5563;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Monitoring active. Run Benchmark or perform I/O to view real-time curves...";
                    font-size: 10px;
                    color: #374151;
                    horizontal-alignment: center;
                }
            }
        }

        // Smart Insights Footer
        Rectangle {
            height: 24px;
            background: Theme.surface-card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-card;
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Smart Insights: " + root.insights_text;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-main;
                    vertical-alignment: center;
                }
            }
        }
    }
}
